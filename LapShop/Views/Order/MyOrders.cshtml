@model List<TbSalesInvoice>
@{
    var invoices = Model.AsEnumerable().Reverse().ToList(); // Reverse the list
    var total = invoices.Count;
    var index = 0;
}
<div class="w-full bg-white flex flex-col rounded-2xl p-4 gap-6 ">
<partial name="_Breadcrumb" />

<section class="bg-white min-h-screen">
    <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
        <h2 class="text-xl font-semibold text-primary-800 sm:text-2xl">My Orders</h2>

        <div class="mt-6 sm:mt-8 md:gap-6 lg:flex lg:items-start xl:gap-8">
            <div class=" w-full flex-none">
                <div class="space-y-6">
                    @foreach (var invoice in invoices)
                    {
                        var indexPlus = ++index;
                        var status = (indexPlus == 1) ? "Shipping" : "Delivered";
                        var badgeColor = (status == "Shipping") ? "bg-blue-100 text-blue-700" : "bg-green-100 text-green-700";

                        <div class="rounded-lg border border-neutral-200 bg-white p-4 shadow-sm md:p-6">
                            <div class="space-y-4 md:flex md:items-center md:justify-between md:gap-6 md:space-y-0">
                                <a href="#" class="shrink-0 md:order-1">
                                    <img class="h-20 w-20" src="~/Uploads/Items/@invoice.TbSalesInvoiceItems.ElementAt(0).Item.ImageName" alt="item image" />
                                </a>
                                <div class="w-full min-w-0 flex-1 space-y-4 md:order-2 md:max-w-md">
                                    <a href="#"
                                       class="text-base font-medium text-primary-800 hover:underline ">Order Id: @invoice.InvoiceId</a>
                                </div>
                                <div class="w-full min-w-0 flex-1 space-y-4 md:order-2 md:max-w-md">
                                    <a href="#"
                                       class="text-base font-medium text-primary-800 hover:underline ">Order Date: @invoice.InvoiceDate</a>
                                </div>
                                <div class="w-full min-w-0 flex-1 space-y-4 md:order-2 md:max-w-md">
                                    <a href="#"
                                       class="text-base font-medium text-primary-800 hover:underline ">Number of Items: @invoice.TbSalesInvoiceItems.Count</a>
                                </div>
                                <div class="md:order-3">
                                    <span class="inline-block rounded-full px-3 py-1 text-sm font-semibold  @badgeColor">
                                        @status
                                    </span>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</section>
</div>
